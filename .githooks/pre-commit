#!/usr/bin/env bash
# A fast, no-network, no-build gate that runs BEFORE the commit exists.
#
# The client has a pre-commit gate; the laboratory did not, so every check ran
# only in CI, after the bad commit was already in history. That is not
# hypothetical here: an injected proof body was once committed to a source file
# for exactly that reason, and verify.yml's check:clean-source exists to catch it
# ninety seconds into CI — this catches the same class at the door instead.
#
# Kept to seconds on purpose: package.json validity, the injected-proof guard,
# and workflow sanity. The full suite — build, browser, mutation, the confidence
# gate — stays in verify; a pre-commit that ran all of it is one nobody keeps
# enabled, and a disabled gate guards nothing.
#
# Enabled per session by scripts/install_pkgs.sh (git config core.hooksPath
# .githooks), scoped to cloud sessions; a local machine is left to opt in.
set -euo pipefail

echo "pre-commit: fast gate…"

node -e "JSON.parse(require('fs').readFileSync('package.json','utf8'))" \
  || { echo "pre-commit: package.json is not valid JSON"; exit 1; }

npm run --silent check:clean-source
npm run --silent check:workflows
# Added 2026-08-23. check:history asks this same question of history, but it is
# settled at commit time, so by the time CI reports it the only remedy left is
# moving docs/history-boundary.txt -- which had moved twice in seven days and
# was about to move a third time. Asked here, it is still answerable.
npm run --silent check:staged-outbox
# Added 2026-08-23. A staged claim with no executor can only be cleared by a
# human remembering to look -- which is how closing-odds sat two days past its
# own passing result. Docs-only scan, no network, so it belongs at the door.
npm run --silent check:staged-verifier
# Added 2026-08-23. docs/history-boundary.txt names a commit by sha, and a
# rebase renames commits. a4d500c was orphaned 42 seconds after being written as
# the boundary -- by the same push -- and check:history then failed five
# consecutive CI runs on a repo where nothing was wrong but one stale sha. Asked
# here, right after the rebase, the answer is one edit away. Silent when the sha
# is unknown: a shallow clone is the ordinary case in a cloud session.
npm run --silent check:boundary
# Added 2026-08-29. Three modules written in one session -- cc-cmd-status-check,
# check-script-orphans, fetch-silently-empty-probe -- each exported functions and
# each did its work at import time, so importing any of them ran the checker and
# exited the process. verify.yml caught all three, but only after the commits had
# landed, and it was red for three consecutive commits before anyone read the
# log. The probe imports 25 modules in fresh processes and takes about a second,
# no network and no build, so the door is where it belongs.
npm run --silent check:import-purity
# Added 2026-08-29, after this exact check failed verify on THREE consecutive
# commits and blocked the deploy each time -- deploy.yml triggers on
# `workflow_run: [verify] completed`, so a red verify means the site silently
# stays behind main. It is a docs-only scan with no network and no build, and it
# reports its own repair ("src/Scoreboard.fs:267 -> now :270"), so the whole
# failure is a one-line edit at the door instead of a six-minute CI round trip.
#
# It also catches the shape this hook already guards elsewhere: a citation whose
# line number moved because the SAME commit moved it.
npm run --silent check:citations
# Added 2026-09-05. `&&` and `.every` do two jobs at once -- they state a claim
# AND they schedule the work -- and short-circuiting is correct for the claim,
# wrong for the measurement. mutation-check's baseline stopped at its first
# failing command for twelve days, so a RED gate ran FASTER than a green one,
# its duration was read as the cost of a passing run, the job timeout was sized
# against that number, and the next green run was cancelled having measured
# nothing. The verdict was right the whole time; only the coverage was wrong,
# which is why nothing caught it. Pure regex over scripts/, no network and no
# build, so it belongs at the door.
npm run --silent check:short-circuit
# Added 2026-10-09. The block docs/SETUP-SCRIPT.md tells a human to paste into
# the cloud environment Setup script field held a bare `npm install` for 61 days
# and killed every new session in that environment; the field cannot be read or
# written from a session, but the text someone copies from can be. Docs-only
# scan, no network, instant, so it belongs at the door.
npm run --silent check:setup-script

echo "pre-commit: ok"
