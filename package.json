{
  "name": "field-laboratory",
  "version": "0.0.0",
  "private": true,
  "description": "FIELD Laboratory \u2014 F# compiled to JavaScript via Fable.",
  "type": "module",
  "scripts": {
    "build": "dotnet fable src/Laboratory.fsproj --outDir build && node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "URL='http://localhost:8080/?data=context-2026-05-15' node scripts/render-check.mjs",
    "check:hard": "URL='http://localhost:8080/?data=games-2026-08-09' node scripts/render-check.mjs",
    "site": "node scripts/build-site.mjs",
    "check:live": "node scripts/render-check.mjs",
    "check:nav": "node scripts/nav-check.mjs",
    "check:proof": "node scripts/proof-check.mjs",
    "check:deployed": "node scripts/live-grouping-check.mjs",
    "gate": "node scripts/confidence.mjs",
    "check:zone": "node scripts/zone-check.mjs",
    "check:window": "node scripts/window-check.mjs",
    "check:workflows": "node scripts/workflow-check.mjs",
    "check:gate-rows": "node scripts/gate-inventory.mjs",
    "check:history": "node scripts/history-check.mjs --self-test && node scripts/history-check.mjs"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
