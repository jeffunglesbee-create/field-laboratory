<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The F# SDK adds its own implicit FSharp.Core PackageReference. Left on,
         that sits alongside the explicit pin below as a genuine duplicate
         (NU1504) and resolution picks the SDK's older 10.0.110 anyway, so the
         pin has no effect (NU1605). Disabling the implicit reference is what
         actually makes the pin authoritative. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- An incomplete pattern match is an ERROR here, not a warning. The whole
       claim of the Sport union is "forget a sport and it does not compile";
       FS0025 is a warning by default, which would make that claim depend on the
       zero-warning CI gate rather than on the compiler refusing the build. -->
  <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
</PropertyGroup>

  <!-- F# compilation is order-sensitive: a file may only reference files
       listed above it. Append new files to the bottom of this list unless a
       later file genuinely needs to see them first. -->
  <ItemGroup>
    <!-- The check harness. First: it depends on nothing, and every proof case
         in docs/CHECK-PROOF.md is injected into a file below it. -->
    <Compile Include="Verify.fs" />
    <Compile Include="Units.fs" />
    <!-- FIELD's semantic color system as types. Above Desk.fs, which adds the
         amnesty-gated drama->color bridge on top of it. Depends only on Units. -->
    <Compile Include="Palette.fs" />
    <!-- FIELD's typography as types: two fonts only, one style per role, sealed
         so no component spells a font literal. Depends on nothing. -->
    <Compile Include="Typography.fs" />
    <Compile Include="Prose.fs" />
    <Compile Include="Ceiling.fs" />
    <Compile Include="Journalism.fs" />
    <Compile Include="Corpus.fs" />
    <Compile Include="Scoreline.fs" />
    <!-- Venue weather. Above Desk.fs because it is self-contained. -->
    <Compile Include="Weather.fs" />
    <Compile Include="Venues.fs" />
    <!-- Production's park-factor and umpire tables, generated by
         scripts/generate-scouting.mjs. Above Stats.fs, which builds rows from them. -->
    <Compile Include="Scouting.fs" />
    <!-- Records and probable pitchers from the MLB schedule endpoint. Below
         Scouting.fs because it joins to the slate through the venue aliases. -->
    <Compile Include="Schedule.fs" />
    <Compile Include="Desk.fs" />
    <Compile Include="Pick.fs" />
    <Compile Include="Scout.fs" />
    <Compile Include="Pickem.fs" />
    <Compile Include="Stats.fs" />
    <Compile Include="Scoreboard.fs" />
    <Compile Include="PickView.fs" />
    <Compile Include="PickemView.fs" />
    <Compile Include="WeatherView.fs" />
    <Compile Include="StatsView.fs" />
    <Compile Include="BriefsView.fs" />
    <Compile Include="Program.fs" />
    <!-- The F# suite and its node entry point. Below Program.fs because nothing
         imports them; `node build/VerifyMain.js` is a second entry, and it must
         not pull in Program's browser side effects. -->
    <!-- Real captures read from disk, for the suite only. Above Suite.fs. -->
    <Compile Include="Fixtures.fs" />
    <Compile Include="Suite.fs" />
    <Compile Include="VerifyMain.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Thoth.Json 10.5.1 requires FSharp.Core >= 10.1.203, newer than the
         SDK's 10.0.110. Authoritative only because the implicit reference is
         disabled above; on its own this line is a duplicate, not a pin. -->
    <PackageReference Include="FSharp.Core" Version="10.1.203" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Fable.Fetch" Version="2.7.0" />
    <PackageReference Include="Thoth.Json" Version="10.5.1" />
    <!-- Reactive primitives only (createSignal / createMemo). The view layer
         from this package needs Fable's JSX mode via Feliz.JSX.Solid, which is
         a 2022 beta; the view here is plain typed DOM instead. -->
    <PackageReference Include="Fable.Solid" Version="1.0.0-beta-004" />
  </ItemGroup>

</Project>
