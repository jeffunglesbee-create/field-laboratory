<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The F# SDK adds its own implicit FSharp.Core PackageReference. Left on,
         that sits alongside the explicit pin below as a genuine duplicate
         (NU1504) and resolution picks the SDK's older 10.0.110 anyway, so the
         pin has no effect (NU1605). Disabling the implicit reference is what
         actually makes the pin authoritative. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <!-- An incomplete pattern match is an ERROR here, not a warning. The whole
       claim of the Sport union is "forget a sport and it does not compile";
       FS0025 is a warning by default, which would make that claim depend on the
       zero-warning CI gate rather than on the compiler refusing the build. -->
  <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
</PropertyGroup>

  <!-- F# compilation is order-sensitive: a file may only reference files
       listed above it. Append new files to the bottom of this list unless a
       later file genuinely needs to see them first. -->
  <ItemGroup>
    <Compile Include="Units.fs" />
    <Compile Include="Desk.fs" />
    <Compile Include="Pick.fs" />
    <Compile Include="Scout.fs" />
    <Compile Include="Scoreboard.fs" />
    <Compile Include="PickView.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Thoth.Json 10.5.1 requires FSharp.Core >= 10.1.203, newer than the
         SDK's 10.0.110. Authoritative only because the implicit reference is
         disabled above; on its own this line is a duplicate, not a pin. -->
    <PackageReference Include="FSharp.Core" Version="10.1.203" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageReference Include="Fable.Promise" Version="3.2.0" />
    <PackageReference Include="Fable.Fetch" Version="2.7.0" />
    <PackageReference Include="Thoth.Json" Version="10.5.1" />
    <!-- Reactive primitives only (createSignal / createMemo). The view layer
         from this package needs Fable's JSX mode via Feliz.JSX.Solid, which is
         a 2022 beta; the view here is plain typed DOM instead. -->
    <PackageReference Include="Fable.Solid" Version="1.0.0-beta-004" />
  </ItemGroup>

</Project>
